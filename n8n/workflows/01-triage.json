    {
      "id": "aa767a40-cdb7-56bc-8633-7aa6b6afcefc",
      "name": "Score risk",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        300
      ],
      "parameters": {
        "jsCode": "// RISK SCORING - every point is explained in `reasons`\nconst a = $input.first().json.body;\nconst base = { brute_force: 35, spraying: 25, impossible_travel: 45, success_after_failures: 60 };\nlet score = base[a.type] ?? 30;\nconst reasons = [`base(${a.type})=${score}`];\nconst add = (n, why) => { score += n; reasons.push(`${why}=+${n}`); };\nif (a.privileged) add(30, 'privileged account');\nif (a.new_ip) add(15, 'IP never seen for this user');\nconst h = new Date((a.event_time || Date.now() / 1000) * 1000).getUTCHours();\nif (h < 5) add(5, 'off-hours (00-05 UTC)');\nif ((a.count || 0) >= 20) add(10, 'high attempt count');\nif ((a.abuse_score || 0) >= 50) add(20, 'IP reputation (AbuseIPDB)');\nscore = Math.min(score, 100);\nconst level = score >= 70 ? 'high' : score >= 30 ? 'medium' : 'low';\n// proportional response matrix\nlet decision = level === 'low' ? 'log_only' : level === 'medium' ? 'ask_user' : 'analyst';\nif (a.privileged) decision = 'analyst';                       // privileged accounts: ALWAYS a human\nif (a.type === 'spraying') decision = score >= 70 ? 'analyst' : 'log_only'; // IP-level, no single victim\nif (decision === 'ask_user' && !a.email) decision = 'analyst'; // cannot ask someone with no mailbox\nreturn [{ json: { ...a, score, level, decision, reasons } }];\n"
      }
    },
    {
      "id": "d0946953-6ca7-5905-ac69-17c39b2b7812",
